# Dogfood Owlpane SaaS (Scale org) — copy to examples/.env and fill secrets from the console.
# Do not commit .env.

OWLPANE_API_URL=https://api.owlpane.com
OWLPANE_INGEST_URL=https://ingest.owlpane.com
OWLPANE_CONSOLE_URL=https://app.owlpane.com

OWLPANE_ENVIRONMENT=production
OWLPANE_DOGFOOD_MODE=rich

OWLPANE_ONBOARD_EMAIL=you@yourcompany.com
OWLPANE_ONBOARD_PASSWORD=
OWLPANE_ORG_SLUG=scale

# After: ./scripts/onboard-dogfood.sh --write-env
# OWLPANE_INGEST_KEY_NODE=owl_ing_...
# OWLPANE_INGEST_KEY_GO=...
# ...
